{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-composition-grader",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://ai-composition-grader.mickyzhou7.workers.dev"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-composition-grader",
    "database_id": "3587491a-0c64-4c87-84ec-1974689da694",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ai-composition-grader-files" }],
  "queues": {
    "producers": [
      { "binding": "ANALYSIS_QUEUE", "queue": "ai-composition-grader-analysis" },
      { "binding": "ANALYSIS_DLQ", "queue": "ai-composition-grader-analysis-dlq" }
    ],
    "consumers": [{ "queue": "ai-composition-grader-analysis", "dead_letter_queue": "ai-composition-grader-analysis-dlq" }]
  }
}
